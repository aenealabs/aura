# Coverage configuration for the dependency-triage control ONLY.
#
# Deliberately separate from pyproject.toml's [tool.coverage.*] tables, which
# gate `--cov=src` at 70%. Pooling scripts/security into that config would let
# one `fail_under` span two trees with wildly different test density (a
# reviewer measured ~8% across ~5,670 statements if all of scripts/ were
# folded into the src source list) -- the only way to green that would be
# lowering the src floor, which is forbidden. This file keeps the two gates
# from ever being able to interact.
#
# Scope: dep_triage.py, dep_triage_collect.py, dep_triage_consolidate.py, and
# dep_risk_register.py (the shared register parser both dep_triage_collect.py
# and dep_risk_audit.py use) -- 873 statements measured at 98.51% (13 missed)
# as of this commit. This is the code that decides whether a dependency PR is
# safe to merge; it should not be the least-gated code in the repo.
#
# dep_risk_audit.py, the other module in scripts/security/, is deliberately
# NOT in this gate. It is a separate, pre-existing tool with its own, much
# sparser test suite (163 statements, 15.34% covered by
# tests/security/test_dep_risk_audit.py, which only exercises
# _watch_tier_packages). Pooling it in pulls the combined figure to ~85%, and
# the only way to green one fail_under across both would be lowering the 90
# floor -- weakening the gate for the code it exists to protect. Raising
# dep_risk_audit.py's own coverage is a separate, larger task (it needs its
# own test suite, not a threshold change) and is out of scope for this
# branch.
#
# Scoping mechanism: the workflow step passes the four modules as separate
# dotted `--cov=scripts.security.<module>` arguments (NOT `--cov=scripts/
# security`, and NOT a directory `source =` here) -- pytest-cov builds its
# `source` list from exactly those CLI values, so only these four files are
# ever measured, imported-or-not. `source` is intentionally absent from this
# file: coverage.py ignores `include`/`omit`-by-directory patterns whenever
# `source` is also set via config, and setting a directory `source` here
# would silently pull dep_risk_audit.py back in (confirmed while building
# this file: it re-appeared at 0% covered the moment `source` was added).
#
# Used by the "Run scripts/security coverage gate" step in
# .github/workflows/code-quality.yml.
#
# Not read implicitly by the default `pytest` invocation (which uses
# pyproject.toml's addopts) -- only invoked explicitly via
# `--cov-config=.coveragerc-scripts` in that one step.
#
# INI format (configparser), not TOML: coverage.py only parses TOML syntax
# for files literally named *.toml. Any other filename -- including this
# dotted one -- is read as a classic .coveragerc.

[run]
data_file = .coverage.scripts
omit =
    */tests/*
    */__pycache__/*

[report]
fail_under = 90
show_missing = True
skip_covered = False
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    except ImportError:
    if TYPE_CHECKING:

[html]
directory = htmlcov-scripts
